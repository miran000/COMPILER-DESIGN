#include <iostream>
#include <fstream>
#include <string>
#include <regex>

bool isIdentifier(const std::string& token) {
    // An identifier should start with a letter or an underscore, and may contain letters, digits, and underscores.
    std::regex identifierRegex("^[a-zA-Z_][a-zA-Z0-9_]*$");
    return std::regex_match(token, identifierRegex);
}

bool isLiteral(const std::string& token) {
    // Check if token is a number (integer or floating-point)
    std::regex integerRegex("^[+-]?\\d+$");
    std::regex floatRegex("^[+-]?\\d*\\.\\d+$");
    std::regex stringLiteralRegex("^\".*\"$"); // String literals are enclosed in double quotes
    
    return std::regex_match(token, integerRegex) || std::regex_match(token, floatRegex) || std::regex_match(token, stringLiteralRegex);
}

bool isOperator(const std::string& token) {
    // A simple list of common operators (you can add more if needed)
    std::vector<std::string> operators = {"+", "-", "*", "/", "=", "==", "&&", "||", "!", "<", ">", "+=", "-="};
    return std::find(operators.begin(), operators.end(), token) != operators.end();
}

bool isWhitespace(const std::string& token) {
    // A whitespace token consists of space or tabs
    return token == " " || token == "\t" || token.empty();
}

int main() {
    std::ifstream inputFile("input.txt");

    if (inputFile.is_open()) {
        std::string line;

        // Process each line in the file
        while (std::getline(inputFile, line)) {
            std::cout << "Line: " << line << std::endl;

            // Tokenize the line using space as the delimiter
            std::istringstream stream(line);
            std::string token;
            
            while (stream >> token) {
                std::cout << "Token: " << token << " -> ";

                // Check token type
                if (isIdentifier(token)) {
                    std::cout << "Identifier" << std::endl;
                } else if (isLiteral(token)) {
                    std::cout << "Literal" << std::endl;
                } else if (isOperator(token)) {
                    std::cout << "Operator" << std::endl;
                } else if (isWhitespace(token)) {
                    std::cout << "Whitespace" << std::endl;
                } else {
                    std::cout << "Unknown" << std::endl;
                }
            }
        }
    } else {
        std::cerr << "Failed to open the file!" << std::endl;
    }

    return 0;
}
